# ── Required for all 3 agents (web search → script → audio) ──────────────────

# Anthropic — claude.ai → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Tavily — tavily.com → free tier (1,000 searches/month)
TAVILY_API_KEY=tvly-...

# ElevenLabs — elevenlabs.io → free tier (10,000 chars/month)
ELEVENLABS_API_KEY=...

# ── Required only for video generation (Agent 4, generateVideo: true) ─────────

# Google AI Studio — ai.google.dev → Get API Key
# Used for Veo 3 video generation. Requires a paid Google AI plan.
# Docs: https://ai.google.dev/gemini-api/docs/video
GOOGLE_AI_API_KEY=...
